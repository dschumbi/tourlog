generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Tour {
  id                    Int      @id @default(autoincrement())
  date                  DateTime
  tourType              String
  tourKind              String   // "public" | "private" | "cancelled"
  paxCount              Int?
  hotelPickup           Boolean  @default(false)
  fiveStarReviews       Int      @default(0)
  cancellationWithin48h Boolean  @default(false)
  cashCount             Int?
  mvvSingleTickets      Int      @default(0)
  mvvGroupTickets       Int      @default(0)
  mvvReceiptUrls        String[]
  feeOverride           Float?
  reviewBilled          Boolean  @default(false)
  notes                 String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  expenses              Expense[]
  tourGuests            TourGuest[]
}

model TourType {
  id        String  @id
  label     String
  flatFee   Float?
  tiers     Json    @default("[]")
  sortOrder Int     @default(0)
}

model Expense {
  id          Int      @id @default(autoincrement())
  date        DateTime
  description String
  grossAmount Float
  vatRate     Float    // 7 oder 19
  tourId      Int?
  tour        Tour?    @relation(fields: [tourId], references: [id], onDelete: SetNull)
  receiptUrl  String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Country {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  sortOrder  Int         @default(0)
  tourGuests TourGuest[]
}

model TourGuest {
  id         Int     @id @default(autoincrement())
  tourId     Int
  tour       Tour    @relation(fields: [tourId], references: [id], onDelete: Cascade)
  countryId  Int
  country    Country @relation(fields: [countryId], references: [id], onDelete: Cascade)
  guestCount Int
  tip        Float   @default(0)

  @@unique([tourId, countryId])
}

model Settings {
  id             String @id @default("singleton")
  // Eigene Daten (fest, in Code)
  // Eigene Daten
  ownerName      String @default("")
  ownerAddress   String @default("")
  ownerCity      String @default("")
  ownerEmail     String @default("")
  ownerTaxId     String @default("")
  // Bankverbindung
  bankName       String @default("")
  bankIban       String @default("")
  bankBic        String @default("")
  // Veranstalter (konfigurierbar)
  clientName     String @default("")
  clientAddress  String @default("")
  clientCity     String @default("")
  clientEmail    String @default("")
  // Rechnungseinstellungen
  invoicePrefix  String @default("RE")
  paymentDays    Int    @default(14)
  // MVV Tickets
  mvvSinglePrice Float  @default(0)
  mvvGroupPrice  Float  @default(0)
  // Passwort-Schutz
  passwordHash   String @default("")
  // n8n Webhook
  n8nWebhookUrl  String @default("")
}
